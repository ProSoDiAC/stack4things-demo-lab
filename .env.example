# Stack4Things demo lab — configuration. Copy to .env (./lab init does it for you).
# Everything here has a working default; the lab is designed for local/LAN demos.

# Compose project name: prefixes network and volume names (<project>_s4t, <project>_lr_var, ...).
COMPOSE_PROJECT_NAME=s4t

# Address participants use to reach this host (used in printed URLs and by the helper scripts).
S4T_LAB_HOST=127.0.0.1

# Absolute path of this checkout (set by ./lab init; needed by lr-log-proxy for `docker run -v`).
REPO_ROOT=

# Published-port bind addresses.
#   BIND_PUBLIC   : Horizon, Grafana, WSTUN, Crossbar, Lightning-Rod dashboards
#   BIND_INTERNAL : databases, message bus, Keystone/Conductor APIs, metrics/FL control (admin surface)
# Use 0.0.0.0 for BIND_INTERNAL only on a trusted network.
BIND_PUBLIC=0.0.0.0
BIND_INTERNAL=127.0.0.1

# Docker network used by every container (pick a free range; also used by manual Lightning-Rod helpers).
S4T_SUBNET=10.250.0.0/24
S4T_GATEWAY=10.250.0.1

# --- credentials ---
# The service credentials (Horizon admin/s4t, DB root/unime, RabbitMQ openstack/unime, ...) are fixed
# lab defaults baked into conf/ and the helper scripts. Only these are safe to change here:
GRAFANA_ADMIN_PASSWORD=admin
LAB_SSH_PASSWORD=arancino      # root password of sshd inside the Lightning-Rod containers
LAB_SSHD=1                     # 0 disables sshd inside the Lightning-Rods (SSH-over-WSTUN demo)

# --- pinned images (override to upgrade) ---
IMG_CONDUCTOR=docker.io/mdslab/iotronic-conductor@sha256:dd0bc870061e3852b1f52cfba813631d23418741486e54c0cb49a6ed9ba1f0f0
IMG_WAGENT=docker.io/mdslab/iotronic-wagent@sha256:c8c4eb410183d132509a74e9ac95d920003f0fddb048af40fbc26daa7e868fce
IMG_UI=docker.io/mdslab/iotronic-ui@sha256:403a301b446818138e008872b459a52f3caff9fa169ef276092ad9ddac119db8
IMG_KEYSTONE=docker.io/mdslab/iotronic-keystone@sha256:8b45ec1ae042b681f390b66b938e1398fb81836d28e6b4581d2a0d80a3f38dc3
IMG_WSTUN=docker.io/mdslab/iotronic-wstun@sha256:acf360677992a1ffaa4001f8424c38f0864e08665268a2ad7a4c461421984cb5
IMG_LR=docker.io/mdslab/lrod@sha256:ced3d53c277b0f71d7d26eb980b84f4cf40c8c4b9360aa4a7b2c41bbf1fc66e7
IMG_CROSSBAR=docker.io/crossbario/crossbar@sha256:bc193d9d4f20cd878113d66d538a085588533897ef99a0508ab558f5a2fe9a2e
